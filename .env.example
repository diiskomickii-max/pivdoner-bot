# Токены бота (основной и резервный с авто-переключением)
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
FALLBACK_BOT_TOKEN=

# ID группы кухни / администраторов (куда приходят все заказы)
MANAGER_CHAT_ID=-100xxxxxxxxxx

# Список Telegram ID администраторов через запятую
ADMIN_IDS=123456789

# Режим работы: 0 = боевой (заказы в группу кухни), 1 = демо (в личку)
DEMO_MODE=0

SELLER_CONTACT=@xxlkkl
PORT=8082
WEBAPP_URL=https://example.github.io/pivdoner-bot/
PAYMENT_URL=https://pay.example.com/pay?order={order_id}&sum={amount}
PAYMENT_ENABLED=1
# Внешний URL сервиса для keep-alive пинга (Render/Railway выставляют автоматически)
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
